// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id       String   @id // client-generated session uuid
  lat      Float // ALREADY privacy-offset coords (raw is never stored)
  lng      Float
  busy     Boolean  @default(false) // true while in an active connection
  lastSeen DateTime
  // Server-side connection state (S2), so signals can be checked against it:
  requestTo String? // session we have an outstanding request to
  peerId    String? // session we're connected to (set on accept, with busy)

  @@index([lastSeen])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      SignalType
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}

// Enforced by the database too (S6), not just by the API route.
enum SignalType {
  request
  accept
  decline
  offer
  answer
  ice
  end
}

model RateLimit {
  // Fixed-window request counter (S3). key = "<bucket>:<session or ip>".
  // Rows are tiny and swept periodically by /api/poll.
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
}
