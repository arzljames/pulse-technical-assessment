DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# Signs session tokens (S1). 32+ random characters, required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Optional TURN relay for "Hide my IP" mode (S5). Comma-separated URLs and the
# coturn static-auth-secret (use-auth-secret); short-lived credentials are
# minted per session. Leave empty to disable the option.
TURN_URLS=""
TURN_SECRET=""
